# API Server Configuration
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Frontend Admin Configuration (Vite requires VITE_ prefix for client exposure)
VITE_API_URL=http://127.0.0.1:4000

# Database Configuration (XAMPP MySQL/MariaDB Default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=modern_cms
DATABASE_URL=mysql://root:@127.0.0.1:3306/modern_cms

# Admin Bootstrap Configuration (Used by db:seed)
ADMIN_EMAIL=admin@moderncms.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# Session Security Configuration
SESSION_COOKIE_NAME=modern_cms_session
SESSION_TTL_DAYS=7

# Storage Settings
STORAGE_PATH=./storage
